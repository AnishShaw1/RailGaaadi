{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API Server",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev:api"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Server listening at.*"
        }
      }
    },
    {
      "label": "Start Web Client",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev:web"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://localhost:5173/.*"
        }
      }
    },
    {
      "label": "Start All (RailGaadi Full Stack)",
      "dependsOn": ["Start API Server", "Start Web Client"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
