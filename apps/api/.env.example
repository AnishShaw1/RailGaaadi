# RailGaadi BFF API Environment Variables Example

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# RailRadar API
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# MapTiler API
MAPTILER_API_KEY=your_maptiler_api_key_here

# OpenWeather API
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# OpenTopography API
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here
OPENTOPOGRAPHY_BASE_URL=https://portal.opentopography.org/API
