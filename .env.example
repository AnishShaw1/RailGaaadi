# ==============================================================================
# RailGaadi Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your external API keys.

# Server Settings
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# 1. RailRadar API (Live running status, route schedules, train search)
# Get your API key at: https://railradar.in/
RAILRADAR_API_KEY=rg_your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# 2. MapTiler API (Dark & Satellite vector basemaps for MapLibre)
# Get your API key at: https://www.maptiler.com/cloud/
MAPTILER_API_KEY=your_maptiler_key_here
VITE_MAPTILER_API_KEY=your_maptiler_key_here

# 3. OpenWeather API (Station and route meteorology)
# Get your API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# 4. OpenTopography API (NASA SRTM 30m Global Digital Elevation Model)
# Get your API key at: https://portal.opentopography.org/
OPENTOPOGRAPHY_API_KEY=your_opentopography_key_here
OPENTOPOGRAPHY_BASE_URL=https://portal.opentopography.org/API

